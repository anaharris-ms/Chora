{
	"name": "chora",
	"version": "0.1.0",
	"private": true,
	"description": "Chora — Where texts dream.",
	"main": ".vite/build/src/main/main.js",
	"scripts": {
		"postinstall": "node scripts/FixMilkdownDeclarations.mjs",
		"start": "npm run dev:mock",
		"start:app": "npm run build && electron-forge start",
		"dev:mock": "node scripts/StartMode.mjs mock",
		"dev:kimi": "node scripts/StartMode.mjs kimi",
		"dev:relay": "node scripts/StartMode.mjs copilot-relay",
		"package": "npm run build && electron-forge package",
		"make": "npm run build && electron-forge make",
		"build": "npm run build:main && npm run build:preload && npm run build:renderer",
		"build:main": "tsc -p tsconfig.main.json",
		"build:preload": "node scripts/BuildPreload.mjs",
		"build:renderer": "node scripts/BuildRenderer.mjs",
		"typecheck": "tsc -p tsconfig.main.json --noEmit",
		"test": "vitest run",
		"corpus:fetch": "ts-node --project tsconfig.scripts.json scripts/corpus/FetchPerseusPlato.ts",
		"corpus:build": "ts-node --project tsconfig.scripts.json scripts/corpus/BuildPerseusPlato.ts",
		"corpus:verify": "ts-node --project tsconfig.scripts.json scripts/corpus/VerifyPerseusPlato.ts",
		"corpus:update": "ts-node --project tsconfig.scripts.json scripts/corpus/UpdatePerseusPlato.ts"
	},
	"dependencies": {
		"@milkdown/kit": "^7.22.1",
		"electron-squirrel-startup": "^1.0.1",
		"gray-matter": "^4.0.3",
		"lucide": "^1.41.0"
	},
	"devDependencies": {
		"@electron-forge/cli": "^7.6.0",
		"@electron-forge/maker-deb": "^7.6.0",
		"@electron-forge/maker-rpm": "^7.6.0",
		"@electron-forge/maker-squirrel": "^7.6.0",
		"@electron-forge/maker-zip": "^7.6.0",
		"@types/node": "^24.0.0",
		"@xmldom/xmldom": "^0.9.8",
		"electron": "^37.0.0",
		"happy-dom": "^20.14.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.0",
		"vite": "^7.0.0",
		"vitest": "^3.2.0"
	}
}
