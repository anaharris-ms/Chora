{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Chora Copilot Relay: Build Extension",
			"type": "shell",
			"command": "npm",
			"args": ["run", "build"],
			"options": {
				"cwd": "${workspaceFolder}/tools/copilot-relay"
			},
			"problemMatcher": ["$tsc"]
		},
		{
			"label": "build",
			"type": "process",
			"command": "C:\\Program Files\\nodejs\\node.exe",
			"args": [
				"scripts\\BuildDebug.mjs"
			],
			"problemMatcher": []
		}
	]
}
